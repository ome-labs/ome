{
  "name": "@ome-labs/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Ome contracts (Aztec.nr 6.0.0, Noir)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./OmeVault.json": "./target/ome_vault-OmeVault.json",
    "./OmeVaultPreview.json": "./target/ome_vault_preview-OmeVaultPreview.json"
  },
  "scripts": {
    "build": "aztec compile",
    "check:failures": "node ../scripts/noir-failure-messages.ts ome_vault",
    "codegen": "aztec codegen target -o artifacts",
    "format": "aztec-nargo fmt --workspace",
    "format:check": "aztec-nargo fmt --workspace --check",
    "lint": "aztec-nargo check --workspace --deny-warnings && pnpm run check:failures",
    "profile": "aztec profile gates target",
    "profile:flamegraphs": "node ../scripts/noir-flamegraphs.ts target ome_vault-OmeVault",
    "test": "aztec test"
  }
}
