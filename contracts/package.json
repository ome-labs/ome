{
  "name": "@ome-labs/contracts",
  "version": "0.3.0",
  "description": "Compiled Aztec contracts of Ome: the OmeVault k-of-n account contract and its review-simulation stand-in",
  "keywords": [
    "account-abstraction",
    "account-contract",
    "aztec",
    "contracts",
    "multisig",
    "noir",
    "ome",
    "privacy",
    "zero-knowledge"
  ],
  "homepage": "https://ome.network",
  "bugs": "https://github.com/ome-labs/ome/issues",
  "license": "Apache-2.0",
  "author": "Ome Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ome-labs/ome.git",
    "directory": "contracts"
  },
  "files": [
    "target/ome_vault-OmeVault.json",
    "target/ome_vault_preview-OmeVaultPreview.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./OmeVault.json": "./target/ome_vault-OmeVault.json",
    "./OmeVaultPreview.json": "./target/ome_vault_preview-OmeVaultPreview.json",
    "./TestRouter.json": "./target/test_router-TestRouter.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "aztec compile",
    "check:failures": "node ../scripts/noir-failure-messages.ts ome_vault",
    "codegen": "aztec codegen target -o artifacts",
    "format": "aztec-nargo fmt --workspace",
    "format:check": "aztec-nargo fmt --workspace --check",
    "lint": "aztec-nargo check --workspace --deny-warnings && pnpm run check:failures",
    "profile": "aztec profile gates target",
    "profile:flamegraphs": "node ../scripts/noir-flamegraphs.ts target ome_vault-OmeVault",
    "test": "aztec test"
  },
  "engines": {
    "node": ">=24"
  }
}
