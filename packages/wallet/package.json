{
  "name": "@ome-labs/wallet",
  "version": "0.0.0",
  "description": "Aztec wallet for Ome vaults: the PXE with a threshold key store, vault deployment, and k-of-n proposals and execution",
  "keywords": [
    "account-abstraction",
    "aztec",
    "multisig",
    "ome",
    "privacy",
    "pxe",
    "threshold-cryptography",
    "wallet",
    "zero-knowledge"
  ],
  "homepage": "https://ome.network",
  "bugs": "https://github.com/ome-labs/ome/issues",
  "license": "Apache-2.0",
  "author": "Ome Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ome-labs/ome.git",
    "directory": "packages/wallet"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aztec-foundation/bb.js": "catalog:",
    "@aztec-labs/accounts": "catalog:",
    "@aztec-labs/aztec.js": "catalog:",
    "@aztec-labs/entrypoints": "catalog:",
    "@aztec-labs/foundation": "catalog:",
    "@aztec-labs/key-store": "catalog:",
    "@aztec-labs/kv-store": "catalog:",
    "@aztec-labs/pxe": "catalog:",
    "@aztec-labs/stdlib": "catalog:",
    "@aztec-labs/wallet-sdk": "catalog:",
    "@ome-labs/api": "workspace:*",
    "@ome-labs/contracts": "workspace:*",
    "@ome-labs/pxe": "workspace:*",
    "@ome-labs/wasm": "workspace:*"
  },
  "devDependencies": {
    "@aztec-labs/noir-contracts.js": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
