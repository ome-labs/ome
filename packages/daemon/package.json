{
  "name": "@ome-labs/daemon",
  "version": "0.1.0",
  "description": "omed, an Ome member's background service: the wallet, the sealed signer, keeper supervision and the daemon API",
  "keywords": [
    "aztec",
    "daemon",
    "multisig",
    "ome",
    "privacy",
    "threshold-cryptography",
    "wallet",
    "zero-knowledge"
  ],
  "homepage": "https://ome.network",
  "bugs": "https://github.com/ome-labs/ome/issues",
  "license": "Apache-2.0",
  "author": "Ome Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ome-labs/ome.git",
    "directory": "packages/daemon"
  },
  "bin": {
    "omed": "./src/omed.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "omed": "./dist/omed.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "bench:proving": "node scripts/bench-proving.ts",
    "drill:testnet": "node scripts/drill-testnet.ts",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:removal": "vitest run -c vitest.removal.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aztec-labs/aztec.js": "catalog:",
    "@aztec-labs/foundation": "catalog:",
    "@aztec-labs/kv-store": "catalog:",
    "@aztec-labs/noir-contracts.js": "catalog:",
    "@aztec-labs/stdlib": "catalog:",
    "@aztec-labs/wallet-sdk": "catalog:",
    "@ome-labs/api": "workspace:*",
    "@ome-labs/wallet": "workspace:*",
    "@ome-labs/wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
