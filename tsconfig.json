{
  "extends": "klarity/tsconfig/app/node",
  "compilerOptions": {
    // Repository scripts run directly under Node: imports name real `.ts` files, and only strippable syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.config.ts", "scripts/**/*.ts"]
}
