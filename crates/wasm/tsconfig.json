{
  "extends": "klarity/tsconfig/app/node",
  "compilerOptions": {
    // Node runs the scripts directly: imports name real `.ts` files, and only syntax Node can strip is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["scripts", "tests", "vitest.config.ts"]
}
