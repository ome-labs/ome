{
  "name": "@ome-labs/wasm",
  "version": "0.0.0",
  "description": "Ome's Rust core as WebAssembly for Node and browsers: threshold viewing, proposals, the signer and membership checks",
  "keywords": [
    "aztec",
    "grumpkin",
    "multisig",
    "noir",
    "ome",
    "privacy",
    "threshold-cryptography",
    "wasm",
    "webassembly",
    "zero-knowledge"
  ],
  "homepage": "https://ome.network",
  "bugs": "https://github.com/ome-labs/ome/issues",
  "license": "Apache-2.0",
  "author": "Ome Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ome-labs/ome.git",
    "directory": "crates/wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/main/web/ome_wasm.d.ts",
        "default": "./dist/main/web/ome_wasm.js"
      },
      "node": {
        "types": "./dist/main/node/ome_wasm.d.ts",
        "default": "./dist/main/node/ome_wasm.js"
      },
      "default": {
        "types": "./dist/main/web/ome_wasm.d.ts",
        "default": "./dist/main/web/ome_wasm.js"
      }
    },
    "./testing": {
      "browser": {
        "types": "./dist/testing/web/ome_wasm.d.ts",
        "default": "./dist/testing/web/ome_wasm.js"
      },
      "node": {
        "types": "./dist/testing/node/ome_wasm.d.ts",
        "default": "./dist/testing/node/ome_wasm.js"
      },
      "default": {
        "types": "./dist/testing/web/ome_wasm.d.ts",
        "default": "./dist/testing/web/ome_wasm.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "node scripts/bench.ts",
    "build": "node scripts/build.ts",
    "generate": "node scripts/build.ts --generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ome-labs/api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
